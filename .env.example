# Public URL of this deployment (no trailing slash). Used for approval_ref links and the install callback.
APP_URL=http://localhost:5173
# 32+ random bytes, base64. Signs the session cookie and the GitHub install state.
SESSION_SECRET=change-me
# SQLite file. Local default is data/reedright.db. Railway: /data/reedright.db on a volume.
# DATABASE_PATH=
# GitHub App (see README "GitHub App setup")
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key, base64-encoded so it survives env var UIs: `base64 -i key.pem | tr -d '\n'`
GITHUB_APP_PRIVATE_KEY_B64=
# Google Drive ingestion (optional): a service account key JSON, base64-encoded. People share Drive folders with its email.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
