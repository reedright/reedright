// reedright object model. All *_at fields are ISO 8601 strings (UTC).
// GitHub is the source of truth for PR state; this DB records identity, tokens, and who asked/approved.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String @map("password_hash")
  name         String
  createdAt    String @map("created_at")

  memberships   Membership[]
  tokens        ApiToken[]
  writeRequests WriteRequest[]
  approvals     Approval[]
  usageLogs     UsageLog[]

  @@map("users")
}

model Org {
  id                   String  @id @default(cuid())
  slug                 String  @unique
  name                 String
  githubInstallationId Int?    @map("github_installation_id")
  repoOwner            String? @map("repo_owner")
  repoName             String? @map("repo_name")
  defaultBranch        String  @default("main") @map("default_branch")
  similarityThreshold  Float   @default(0.9) @map("similarity_threshold")
  siteUrl              String? @map("site_url")
  sitePublishedAt      String? @map("site_published_at")
  createdAt            String  @map("created_at")

  memberships   Membership[]
  invites       Invite[]
  tokens        ApiToken[]
  writeRequests WriteRequest[]
  approvals     Approval[]
  usageLogs     UsageLog[]
  driveSyncs    DriveSync[]
  toolCalls     ToolCall[]

  @@map("orgs")
}

// handle = the identity id used in the brain repo's OWNERS.yaml (e.g. growth-lead).
// Approval rights come from OWNERS.yaml, not from role. role only gates reedright admin pages.
model Membership {
  userId    String @map("user_id")
  orgId     String @map("org_id")
  handle    String
  role      String @default("member") // admin | member
  createdAt String @map("created_at")

  user User @relation(fields: [userId], references: [id])
  org  Org  @relation(fields: [orgId], references: [id])

  @@id([userId, orgId])
  @@unique([orgId, handle])
  @@map("memberships")
}

model Invite {
  id         String  @id @default(cuid())
  orgId      String  @map("org_id")
  email      String
  handle     String
  role       String  @default("member")
  token      String  @unique
  expiresAt  String  @map("expires_at")
  acceptedAt String? @map("accepted_at")
  createdAt  String  @map("created_at")

  org Org @relation(fields: [orgId], references: [id])

  @@map("invites")
}

// Bearer token for the MCP endpoint. Scoped to one (user, org). Plaintext shown once; only the sha256 is stored.
model ApiToken {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  orgId      String  @map("org_id")
  name       String
  tokenHash  String  @unique @map("token_hash")
  prefix     String
  lastUsedAt String? @map("last_used_at")
  revokedAt  String? @map("revoked_at")
  createdAt  String  @map("created_at")
  // OAuth-issued tokens: kind = oauth, bound to a client, expiring, with a rotating refresh token.
  kind             String  @default("pat") // pat | oauth
  clientId         String? @map("client_id")
  expiresAt        String? @map("expires_at")
  refreshTokenHash String? @unique @map("refresh_token_hash")
  refreshExpiresAt String? @map("refresh_expires_at")

  user   User         @relation(fields: [userId], references: [id])
  org    Org          @relation(fields: [orgId], references: [id])
  client OAuthClient? @relation(fields: [clientId], references: [id])

  @@map("api_tokens")
}

// One row per brain_propose that produced a PR.
model WriteRequest {
  id         String @id @default(cuid())
  orgId      String @map("org_id")
  userId     String @map("user_id")
  handle     String
  run        String
  type       String // rule | procedure | ref | observation
  domain     String
  title      String
  path       String
  branch     String
  prNumber   Int    @map("pr_number")
  prUrl      String @map("pr_url")
  status     String @default("open") // open | merged | closed | rejected
  lintReport String @map("lint_report") // JSON LintReport
  kind       String @default("entry") // entry | sync
  paths      String? // JSON string[]: every entry file in the PR (sync requests)
  summary    String? // JSON: sync statistics
  createdAt  String @map("created_at")
  updatedAt  String @map("updated_at")

  org       Org        @relation(fields: [orgId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  approvals Approval[]

  @@index([orgId, status])
  @@map("write_requests")
}

// The approval event. Its page URL is the RFC's approval_ref (a non-git URL).
model Approval {
  id             String  @id @default(cuid())
  writeRequestId String  @map("write_request_id")
  orgId          String  @map("org_id")
  approverUserId String  @map("approver_user_id")
  approverHandle String  @map("approver_handle")
  decision       String // approve | reject
  note           String?
  createdAt      String  @map("created_at")

  writeRequest WriteRequest @relation(fields: [writeRequestId], references: [id])
  org          Org          @relation(fields: [orgId], references: [id])
  approver     User         @relation(fields: [approverUserId], references: [id])

  @@map("approvals")
}

// RFC §6/§8: reads record paths, never prompts.
// One row per MCP tool invocation, for the Reports page. Names and timings only; never arguments or results.
model ToolCall {
  id        String  @id @default(cuid())
  orgId     String  @map("org_id")
  userId    String  @map("user_id")
  handle    String
  tokenId   String  @map("token_id")
  tool      String
  ok        Boolean
  ms        Int
  createdAt String  @map("created_at")

  org Org @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@map("tool_calls")
}

model UsageLog {
  id        String @id @default(cuid())
  orgId     String @map("org_id")
  userId    String @map("user_id")
  handle    String
  run       String
  path      String
  createdAt String @map("created_at")

  org  Org  @relation(fields: [orgId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([orgId, path])
  @@map("usage_logs")
}

// ---- OAuth 2.1 (for MCP clients such as claude.ai connectors) ----

// A registered OAuth client. DCR clients get a random id; CIMD clients are keyed by their metadata URL.
model OAuthClient {
  id                      String  @id
  source                  String // dcr | cimd
  name                    String
  redirectUris            String  @map("redirect_uris") // JSON string[]
  tokenEndpointAuthMethod String  @default("none") @map("token_endpoint_auth_method")
  secretHash              String? @map("secret_hash")
  metadata                String // JSON as registered or fetched
  fetchedAt               String? @map("fetched_at")
  createdAt               String  @map("created_at")

  codes  OAuthCode[]
  tokens ApiToken[]

  @@map("oauth_clients")
}

// One-time authorization code (stored hashed). Binds a client + user + org + PKCE challenge.
model OAuthCode {
  codeHash            String  @id @map("code_hash")
  clientId            String  @map("client_id")
  userId              String  @map("user_id")
  orgId               String  @map("org_id")
  redirectUri         String  @map("redirect_uri")
  codeChallenge       String  @map("code_challenge")
  codeChallengeMethod String  @default("S256") @map("code_challenge_method")
  scope               String?
  resource            String?
  expiresAt           String  @map("expires_at")
  usedAt              String? @map("used_at")
  createdAt           String  @map("created_at")

  client OAuthClient @relation(fields: [clientId], references: [id])

  @@map("oauth_codes")
}

// ---- Google Drive ingestion ----

// A Drive file or folder a member chose to sync into refs/<domain>/. One service account per deployment.
model DriveSync {
  id            String  @id @default(cuid())
  orgId         String  @map("org_id")
  userId        String  @map("user_id")
  handle        String
  domain        String
  driveId       String  @map("drive_id")
  name          String
  mimeType      String  @map("mime_type")
  status        String  @default("idle") // idle | running | error
  lastRunAt     String? @map("last_run_at")
  lastError     String? @map("last_error")
  lastRequestId String? @map("last_request_id")
  createdAt     String  @map("created_at")

  org   Org             @relation(fields: [orgId], references: [id])
  items DriveSyncItem[]

  @@unique([orgId, driveId])
  @@map("drive_syncs")
}

// Per-file state so a re-sync only rewrites what changed and archives what disappeared.
model DriveSyncItem {
  syncId       String  @map("sync_id")
  fileId       String  @map("file_id")
  path         String
  modifiedTime String  @map("modified_time")
  checksum     String?
  requestId     String? @map("request_id")
  renderVersion Int     @default(0) @map("render_version")
  archivedAt    String? @map("archived_at")
  updatedAt     String  @map("updated_at")

  sync DriveSync @relation(fields: [syncId], references: [id])

  @@id([syncId, fileId])
  @@map("drive_sync_items")
}
